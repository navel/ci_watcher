# GitHub App Configuration
# Copy this file to .env and fill in your values
# .env file is ignored by git (see .gitignore)

# GitHub App ID (required)
GITHUB_APP_ID=

# GitHub App Client ID (required, for OAuth)
GITHUB_CLIENT_ID=

# GitHub App Client Secret (optional, for OAuth)
GITHUB_CLIENT_SECRET=

# GitHub App Private Key (REQUIRED for JWT generation)
# For multiline values, use \n for newlines
# Example:
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
# 
# To get your private key:
# 1. Go to https://github.com/settings/apps/YOUR_APP_NAME
# 2. In "Private keys" section, generate or download your key
# 3. Copy the entire key including BEGIN/END lines
# 4. Replace newlines with \n and paste here
GITHUB_PRIVATE_KEY=
