// GitHub App Configuration
// Copy this file to Secrets.xcconfig and fill in your values
// Secrets.xcconfig is ignored by git (see .gitignore)
//
// NOTE: For development, it's easier to store GITHUB_PRIVATE_KEY in Keychain
// using the app's settings UI, rather than here. This field is optional.
// If not provided, the app will use Keychain as fallback.
//
// GITHUB_PRIVATE_KEY can be provided in two formats:
// 1. Base64-encoded (recommended for xcconfig): Single line, no PEM headers
//    Example: GITHUB_PRIVATE_KEY = LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpNSUlF...
// 2. PEM format with \n: Traditional format with literal \n characters
//    Example: GITHUB_PRIVATE_KEY = -----BEGIN RSA PRIVATE KEY-----\nMIIEpgIBAAKCAQEA...
//
// To convert PEM to base64: cat private_key.pem | base64 | tr -d '\n'

GITHUB_APP_ID = 
GITHUB_CLIENT_ID = 
GITHUB_CLIENT_SECRET = 
// xcconfig treats // as a comment, so URLs must use https:/$()/host syntax
CIWATCHER_API_BASE_URL = https:/$()/ciwatcher.navel.uk
// For local backend: http:/$()/localhost:8080
// Optional local fallback only. Production builds should use the backend API.
GITHUB_PRIVATE_KEY = 
// Sparkle auto-update public EdDSA key (embedded in Info.plist; optional here for reference)
SPARKLE_PUBLIC_ED_KEY = k3pomKTiCxM3vZ3UoFqMujifU7v+AvkWu/FQWgZxXsk=
